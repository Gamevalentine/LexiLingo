/index.html
  Cache-Control: no-store

/flutter_bootstrap.js
  Cache-Control: no-store

/main.dart.js
  Cache-Control: max-age=0, must-revalidate

/manifest.json
  Cache-Control: max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=604800

/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable
